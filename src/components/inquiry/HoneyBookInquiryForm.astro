---
interface Props {
  formUrl?: string;
  fallbackUrl?: string;
  fallbackEmail?: string;
  privacyUrl?: string;
}

const { formUrl, fallbackUrl, fallbackEmail, privacyUrl } = Astro.props;
---

<div class="inquiry-provider" data-inquiry-provider data-form-url={formUrl}>
  {formUrl ? (
    <div class="embed-shell" data-embed-shell aria-busy="true">
      <p class="loading-state" data-loading-state role="status">
        Loading the secure inquiry form…
      </p>
      <div class="hb-p-632a07d8b2f1e1000827a1ea-1" data-honeybook-mount></div>
    </div>
  ) : (
    <p role="status">The embedded inquiry form is temporarily unavailable.</p>
  )}
  <div class="form-fallback">
    {fallbackUrl && (
      <p>
        If the embedded form does not load,{' '}
        <a href={fallbackUrl} target="_blank" rel="noreferrer" data-inquiry-link>
          open the inquiry form
        </a>{' '}
        on Emily's current site.
      </p>
    )}
    {fallbackEmail && (
      <p>
        You can also email <a href={`mailto:${fallbackEmail}`}>{fallbackEmail}</a>.
      </p>
    )}
  </div>
  <p class="privacy-note">
    The form is provided by HoneyBook. Information entered inside it is handled under HoneyBook's
    privacy and accessibility practices; some browser and assistive-technology behavior is outside
    this site's control. {privacyUrl && <a href={privacyUrl}>Read this site's privacy policy.</a>}
  </p>
</div>

<script>
  const provider = document.querySelector<HTMLElement>('[data-inquiry-provider]');
  const shell = provider?.querySelector<HTMLElement>('[data-embed-shell]');
  const loadingState = provider?.querySelector<HTMLElement>('[data-loading-state]');

  const trackStart = () => {
    if (!provider || provider.dataset.started === 'true') return;
    provider.dataset.started = 'true';
    window.gtag?.('event', 'inquiry_start');
  };

  const connectFrame = (frame: HTMLIFrameElement) => {
    if (frame.dataset.honeybookFrame === 'true') return;
    frame.dataset.honeybookFrame = 'true';
    frame.title = 'Wedding hair inquiry form';
    frame.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
    shell?.setAttribute('aria-busy', 'false');
    loadingState?.setAttribute('hidden', '');

    window.addEventListener('blur', () => {
      if (document.activeElement === frame) trackStart();
    });
  };

  const observer = new MutationObserver(() => {
    const frame = provider?.querySelector<HTMLIFrameElement>('[data-honeybook-mount] iframe');
    if (frame) {
      connectFrame(frame);
      observer.disconnect();
    }
  });

  if (provider?.dataset.formUrl && shell) {
    observer.observe(shell, { childList: true, subtree: true });
    window._HB_ = window._HB_ || {};
    window._HB_.pid = '632a07d8b2f1e1000827a1ea';

    const script = document.createElement('script');
    script.src =
      'https://widget.honeybook.com/assets_users_production/websiteplacements/placement-controller.min.js';
    script.async = true;
    script.addEventListener('error', () => shell.setAttribute('aria-busy', 'false'));
    document.head.append(script);
  }

  document.querySelectorAll<HTMLElement>('[data-inquiry-link]').forEach((link) => {
    link.addEventListener('click', trackStart, { once: true });
  });
</script>

<style>
  .embed-shell {
    position: relative;
    min-height: 99rem;
    background: var(--color-surface);
  }

  [data-honeybook-mount] {
    width: 100%;
  }

  [data-honeybook-mount] :global(iframe) {
    display: block;
    width: 100%;
    max-width: 100%;
    border: 0;
    background: var(--color-surface);
  }

  .loading-state {
    position: absolute;
    inset: var(--space-5) auto auto 50%;
    margin: 0;
    translate: -50% 0;
  }

  .form-fallback,
  .privacy-note {
    max-width: 48rem;
    margin-top: var(--space-4);
    font-size: var(--step--1);
  }

  .form-fallback p {
    margin-bottom: var(--space-2);
  }
</style>
