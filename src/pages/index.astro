---
import heroImage from '@/assets/source/04-bride-015a0371.jpg';
import emilyPortrait from '@/assets/source/10-branding-3255.jpg';
import ButtonLink from '@/components/global/ButtonLink.astro';
import ResponsiveImage from '@/components/content/ResponsiveImage.astro';
import VideoShowcase from '@/components/content/VideoShowcase.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { galleryImages, homeGallery } from '@/lib/gallery';
import { isProductionContent } from '@/lib/env';
import {
  getGalleryItems,
  getPackages,
  getSiteSettings,
  getTestimonials,
  getVideoItems,
} from '@/lib/sanity/content';
import { businessSchema } from '@/lib/seo/schema';

const title = "Romantic Bridal Hair in Denver, Colorado | Em's Bridal Hair";
const description =
  'Romantic, effortless bridal hairstyling and a thoughtfully paced wedding morning in Denver and across Colorado.';
const siteUrl = import.meta.env.PUBLIC_SITE_URL || undefined;
const [packages, testimonials, settings, gallery, videos] = await Promise.all([
  getPackages(),
  getTestimonials(),
  getSiteSettings(),
  getGalleryItems(),
  getVideoItems(),
]);
const selectedWork = homeGallery(galleryImages(gallery));
const experienceStats = settings?.experienceStats || [];
const availability = settings?.bookingAvailability;
const draftExcerpts: Record<string, string> = {
  Kailey: "My mom also loved her; we couldn't stop smiling ever after the bridal preview!",
  Caley: "I can't even put into words how confident Emily made me feel on my wedding day.",
};
const selectedTestimonials = testimonials.some((item) => item.contentStatus === 'OWNER_APPROVED')
  ? testimonials.filter((item) => item.featured).slice(0, 2)
  : testimonials.filter((item) => item.clientName in draftExcerpts).slice(0, 2);
const homeTestimonials = selectedTestimonials.map((item) => ({
  ...item,
  homeQuote:
    item.excerpt ||
    (!isProductionContent &&
    item.contentStatus !== 'OWNER_APPROVED' &&
    item.quote.includes(draftExcerpts[item.clientName])
      ? draftExcerpts[item.clientName]
      : item.quote),
}));
---

<BaseLayout
  title={title}
  description={description}
  headerTheme="light"
  schema={businessSchema(siteUrl)}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-media">
      <ResponsiveImage
        src={heroImage}
        alt="Finished half-up bridal curls flowing down a bride's back as she embraces her partner"
        widths={[480, 768, 1080, 1440, 1920]}
        sizes="(min-width: 56rem) 54vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="hero-image"
        position="52% 32%"
      />
      <div class="hero-shade" aria-hidden="true"></div>
    </div>
    <div class="hero-content">
      <p class="eyebrow">Denver · Colorado</p>
      <h1 id="hero-title">Romantic bridal hair in Denver &amp; Colorado.</h1>
      <p class="hero-specialties">Soft updos, romantic half-ups, and flowing waves.</p>
      <div class="hero-actions">
        <ButtonLink href="/inquire/">Check your date</ButtonLink>
        <ButtonLink href="/portfolio/" variant="text">
          View the portfolio
        </ButtonLink>
      </div>
    </div>
  </section>

  <section class="work section-shell" aria-labelledby="selected-work-title">
    <header class="section-heading">
      <h2 id="selected-work-title">Selected work</h2>
      <ButtonLink href="/portfolio/" variant="text">
        More bridal hair
      </ButtonLink>
    </header>
    <div class="editorial-grid">
      {selectedWork.map((item) => (
        <figure class="editorial-image">
          <div
            class="editorial-frame"
            style={{
              '--photo-scale': item.homeScale || 1,
              '--photo-focus': item.homePosition || item.position || '50% 50%',
            }}
          >
            <ResponsiveImage
              src={item.image}
              alt={item.alt}
              width={item.width}
              height={item.height}
              position={item.homePosition || item.position}
              widths={[320, 480, 660, 768, 960]}
              sizes={`(min-width: 80rem) ${390 * (item.homeScale || 1)}px, (min-width: 56rem) ${30 * (item.homeScale || 1)}vw, (min-width: 23rem) ${44 * (item.homeScale || 1)}vw, ${90 * (item.homeScale || 1)}vw`}
            />
          </div>
          {item.photographerName && (
            <figcaption>
              Photo:{' '}
              {item.photographerUrl ? (
                <a href={item.photographerUrl} rel="noreferrer" target="_blank">
                  {item.photographerName}
                </a>
              ) : (
                item.photographerName
              )}
            </figcaption>
          )}
        </figure>
      ))}
    </div>
  </section>

  <section class="introduction section-shell" aria-label="A note from Emily">
    <p>
      I'm Emily, a Denver bridal hairstylist creating soft updos, half-ups, and waves for weddings
      across Colorado.
    </p>
  </section>

  {videos.length > 0 && <VideoShowcase items={videos} />}

  <section class="packages section-shell" aria-labelledby="packages-title">
    <header class="packages-heading">
      <p class="eyebrow">The collections</p>
      <h2 id="packages-title">Bridal packages</h2>
      <p>
        A bridal preview, a dedicated two-hour wedding-day appointment, and wedding-morning planning
        are included in every collection.
      </p>
    </header>
    <ol class="package-list">
      {packages.map((item, index) => (
        <li data-content-status={item.contentStatus}>
          <span class="package-number" aria-hidden="true">
            0{index + 1}
          </span>
          <div class="package-copy">
            <h3>{item.name}</h3>
            <p>{item.partySize}</p>
            {item.includesSecondArtist && <p class="package-artist">Second artist included</p>}
          </div>
          <p class="package-price">
            <small>{item.priceQualifier || 'Starting at'}</small>
            {item.price}
          </p>
        </li>
      ))}
    </ol>
    <div class="package-footer">
      <p>Travel, timing, staffing, and additions are confirmed in your proposal.</p>
      <ButtonLink href="/services/" variant="text">
        Compare packages
      </ButtonLink>
    </div>
  </section>

  <section class="artist" aria-labelledby="artist-title">
    <div class="artist-inner section-shell">
      <div class="artist-image">
        <ResponsiveImage
          src={emilyPortrait}
          alt="Emily, the hairstylist behind Em's Bridal Hair"
          widths={[320, 480, 768, 960]}
          sizes="(min-width: 56rem) 34vw, 80vw"
          position="50% 25%"
        />
      </div>
      <div class="artist-copy">
        <p class="eyebrow">Behind the style</p>
        <h2 id="artist-title">Meet Emily.</h2>
        <p>
          Romantic texture is my favorite part of the work. I'll help you find a style that feels
          like you.
        </p>
        <p>
          From a bridal team in Dallas to weddings across Colorado, I bring years of styling and
          education experience to the chair.
        </p>
        <ButtonLink href="/about/" variant="text">
          More about Emily
        </ButtonLink>
        <dl
          id="trust-signals"
          class="trust"
          data-content-status={
            experienceStats.every((stat) => stat.contentStatus === 'OWNER_APPROVED')
              ? 'OWNER_APPROVED'
              : 'UNRESOLVED'
          }
        >
          {experienceStats.map((stat) => (
            <div data-content-status={stat.contentStatus}>
              <dt>{stat.label}</dt>
              <dd>{stat.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  {homeTestimonials.length > 0 && (
    <section class="proof section-shell" aria-labelledby="proof-title">
      <h2 id="proof-title">Kind words</h2>
      <div class="quotes">
        {homeTestimonials.map((item) => (
          <figure data-content-status={item.contentStatus}>
            <blockquote>“{item.homeQuote}”</blockquote>
            <figcaption>
              {item.clientName}
              {item.source && (
                <span>
                  {' '}
                  —{' '}
                  {item.sourceUrl ? (
                    <a href={item.sourceUrl} target="_blank" rel="noreferrer">
                      {item.source}
                    </a>
                  ) : (
                    item.source
                  )}
                </span>
              )}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <section class="closing" aria-labelledby="inquiry-title">
    {availability && (
      <p class="eyebrow" data-content-status={availability.contentStatus}>
        {availability.headline}
      </p>
    )}
    <h2 id="inquiry-title">Let's talk about your wedding hair.</h2>
    <ButtonLink href="/inquire/">Check your date</ButtonLink>
  </section>
</BaseLayout>

<style>
  .section-shell {
    width: min(100%, calc(var(--layout-width) + 2 * var(--gutter)));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  h2 {
    font-size: var(--step-3);
  }
  .hero {
    display: grid;
    background: var(--color-background-alt);
  }
  .hero-media {
    position: relative;
    height: clamp(19rem, 48svh, 28rem);
    overflow: hidden;
  }
  .hero :global(.hero-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(46 31 24 / 0.12), transparent 35%);
    pointer-events: none;
  }
  .hero-content {
    align-self: center;
    padding: var(--space-5) var(--gutter) var(--space-6);
  }
  .hero h1 {
    max-width: 17ch;
    margin: 0 0 var(--space-4);
    font-size: var(--step-4);
  }
  .hero .eyebrow {
    margin-bottom: var(--space-3);
  }
  .hero-specialties {
    max-width: 30ch;
    margin-bottom: var(--space-4);
  }
  .package-artist {
    margin-top: var(--space-1) !important;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }
  .work {
    padding-block: var(--space-6) var(--space-4);
  }
  .section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .section-heading h2 {
    margin: 0;
  }
  .editorial-grid {
    display: grid;
    gap: var(--space-3);
  }
  .editorial-image {
    margin: 0;
    min-width: 0;
  }
  .editorial-frame {
    overflow: hidden;
    aspect-ratio: 3 / 4;
  }
  .editorial-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(var(--photo-scale));
    transform-origin: var(--photo-focus);
  }
  .editorial-image figcaption {
    margin-top: var(--space-2);
    font-size: var(--step--1);
  }
  .introduction {
    padding-block: var(--space-6);
    text-align: center;
  }
  .introduction p {
    max-width: 40ch;
    margin: 0 auto;
    font-size: var(--step-2);
    line-height: 1.55;
  }
  .packages {
    padding-block: var(--space-6);
  }
  .packages-heading {
    max-width: 40rem;
    margin-bottom: var(--space-4);
  }
  .packages-heading h2 {
    margin-bottom: var(--space-3);
  }
  .package-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }
  .package-list li {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: var(--space-2) var(--space-3);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  .package-number {
    font-size: var(--step--1);
  }
  .package-copy h3 {
    margin-bottom: var(--space-2);
    font-size: var(--step-2);
  }
  .package-copy p {
    margin: 0;
    font-size: var(--step--1);
  }
  .package-price {
    grid-column: 2;
    margin: 0;
    font-size: var(--step-1);
  }
  .package-price small {
    margin-right: var(--space-2);
    font-size: var(--step--1);
  }
  .package-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-4);
  }
  .package-footer p {
    max-width: 40ch;
    margin: 0;
    font-size: var(--step--1);
  }
  .artist {
    background: var(--color-sage);
    color: var(--color-surface);
  }
  .artist-inner {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-6);
  }
  .artist-image {
    max-width: 26rem;
    width: 85%;
    margin-inline: auto;
  }
  .artist-image :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .artist-copy .eyebrow {
    color: inherit;
  }
  .artist-copy h2 {
    font-size: var(--step-3);
  }
  .artist-copy > p {
    max-width: 34ch;
  }
  .artist-copy :global(.button-link--text) {
    color: var(--color-surface);
  }
  .artist-copy :global(.button-link:focus-visible) {
    outline-color: var(--color-surface);
  }
  .trust {
    display: grid;
    margin: var(--space-5) 0 0;
    border-top: 1px solid color-mix(in srgb, var(--color-surface) 45%, transparent);
  }
  .trust > div {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    justify-content: space-between;
    padding-block: var(--space-3);
    border-bottom: 1px solid color-mix(in srgb, var(--color-surface) 45%, transparent);
  }
  .trust dt {
    order: 2;
    max-width: 18ch;
    font-size: var(--step--1);
  }
  .trust dd {
    margin: 0;
    font-size: var(--step-3);
    line-height: 1.2;
  }
  .proof {
    padding-block: var(--space-6);
  }
  .proof h2 {
    margin-bottom: var(--space-5);
  }
  .quotes {
    display: grid;
    gap: var(--space-5);
  }
  .quotes figure {
    margin: 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .quotes blockquote {
    margin: 0 0 var(--space-3);
    font-size: var(--step-1);
  }
  .quotes figcaption {
    font-size: var(--step--1);
  }
  .closing {
    padding: var(--space-6) var(--gutter);
    text-align: center;
    background: var(--color-background-alt);
  }
  .closing h2 {
    max-width: 24ch;
    margin: 0 auto var(--space-4);
    font-size: var(--step-3);
  }
  @media (min-width: 23rem) {
    .editorial-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 48rem) {
    .package-list li {
      grid-template-columns: 2rem minmax(0, 1fr) auto;
      align-items: center;
      padding-block: var(--space-4);
    }
    .package-price {
      grid-column: 3;
    }
    .package-price small {
      display: block;
    }
    .quotes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
  @media (min-width: 56rem) {
    .hero {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
    .hero-media {
      grid-column: 2;
      grid-row: 1;
      height: min(43rem, 78svh);
      min-height: 35rem;
    }
    .hero-content {
      grid-column: 1;
      grid-row: 1;
      padding-left: max(var(--gutter), calc((100vw - var(--layout-width)) / 2));
      padding-right: var(--space-5);
    }
    .hero h1 {
      font-size: var(--step-4);
    }
    .editorial-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
      padding-bottom: var(--space-4);
    }
    .editorial-image:nth-child(3n + 2) {
      transform: translateY(var(--space-4));
    }
    .artist-inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: center;
      gap: var(--space-7);
    }
    .artist-image {
      width: 100%;
    }
    .trust {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .trust > div {
      display: flex;
      flex-direction: column;
      justify-content: start;
      gap: var(--space-2);
      padding-right: var(--space-3);
    }
  }
  @media (min-width: 100rem) {
    .hero-media {
      height: 43rem;
    }
  }
</style>
