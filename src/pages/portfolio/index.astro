---
import Breadcrumbs from '@/components/content/Breadcrumbs.astro';
import ResponsiveImage from '@/components/content/ResponsiveImage.astro';
import ButtonLink from '@/components/global/ButtonLink.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { galleryImages } from '@/lib/gallery';
import { getGalleryItems } from '@/lib/sanity/content';
import { breadcrumbSchema } from '@/lib/seo/schema';

const title = "Colorado Bridal Hair Portfolio | Em's Bridal Hair";
const description =
  'Explore romantic updos, soft waves, and wedding-morning hairstyling created for brides and bridal parties in Denver and across Colorado.';
const siteUrl = import.meta.env.PUBLIC_SITE_URL || undefined;
const schemas = siteUrl
  ? [
      breadcrumbSchema([
        { name: 'Home', url: siteUrl },
        { name: 'Portfolio', url: new URL('/portfolio/', siteUrl).toString() },
      ]),
    ]
  : [];
const galleryItems = galleryImages(await getGalleryItems());
---

<BaseLayout title={title} description={description} headerTheme="light" schema={schemas}>
  <section class="portfolio-heading section-shell">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Portfolio' }]} />
    <p class="eyebrow">The portfolio</p>
    <h1>
      Bridal hair,
      <br />
      in the details.
    </h1>
    <p>Updos, half-ups, waves, and the wedding moments around them.</p>
  </section>
  <section class="lookbook section-shell" aria-label="Bridal hair portfolio">
    {galleryItems.map((item, index) => (
      <figure class:list={['lookbook-item', { 'lookbook-item--compact': item.compact }]}>
        <div class="lookbook-image">
          <ResponsiveImage
            src={item.image}
            alt={item.alt}
            width={item.width}
            height={item.height}
            position={item.position}
            widths={[320, 480, 660, 768, 960, 1280]}
            sizes={
              item.compact
                ? '(min-width: 48rem) 330px, (min-width: 23rem) 80vw, 90vw'
                : '(min-width: 80rem) 660px, (min-width: 48rem) 46vw, 90vw'
            }
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
          />
        </div>
        <figcaption>
          <span>{item.styleCategory}</span>
          {item.photographerName && (
            <span>
              Photo:{' '}
              {item.photographerUrl ? (
                <a href={item.photographerUrl} target="_blank" rel="noreferrer">
                  {item.photographerName}
                </a>
              ) : (
                item.photographerName
              )}
            </span>
          )}
        </figcaption>
      </figure>
    ))}
  </section>
  <section class="portfolio-note">
    <p class="eyebrow">Your own direction</p>
    <h2>Find a little inspiration.</h2>
    <p>Bring the details you love. We'll find a style that feels like you.</p>
    <ButtonLink href="/inquire/" variant="outline">
      Inquire about your date
    </ButtonLink>
  </section>
</BaseLayout>

<style>
  .section-shell {
    width: min(100%, calc(var(--layout-width) + 2 * var(--gutter)));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .portfolio-heading {
    padding-block: var(--space-5) var(--space-6);
  }
  .portfolio-heading :global(.breadcrumbs) {
    margin-bottom: var(--space-5);
  }
  .portfolio-heading h1 {
    font-size: var(--step-4);
    margin-bottom: var(--space-4);
  }
  .portfolio-heading > p:last-child {
    max-width: 38ch;
    margin: 0;
  }
  .lookbook {
    display: grid;
    gap: var(--space-6);
    padding-bottom: var(--space-7);
  }
  .lookbook-item {
    width: 100%;
    margin: 0;
    min-width: 0;
  }
  .lookbook-item--compact {
    width: min(100%, 20.625rem);
    justify-self: end;
  }
  .lookbook-image {
    overflow: hidden;
  }
  .lookbook-image :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }
  .lookbook-item:nth-child(10n) .lookbook-image :global(img) {
    aspect-ratio: 4 / 5;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    padding-top: var(--space-2);
    font-size: var(--step--1);
  }
  .portfolio-note {
    padding: var(--space-6) var(--gutter);
    text-align: center;
    background: var(--color-background-alt);
  }
  .portfolio-note h2 {
    font-size: var(--step-3);
  }
  @media (min-width: 48rem) {
    .lookbook {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--space-5);
      align-items: start;
    }
    .lookbook-item {
      grid-column: span 6;
      max-width: 41.25rem;
    }
    .lookbook-item:nth-child(4n + 1) {
      grid-column: 1 / 8;
    }
    .lookbook-item:nth-child(4n + 2) {
      grid-column: 9 / 13;
      margin-top: var(--space-6);
    }
    .lookbook-item:nth-child(4n + 3) {
      grid-column: 2 / 8;
    }
    .lookbook-item:nth-child(4n + 4) {
      grid-column: 9 / 13;
      margin-top: var(--space-5);
    }
    .lookbook-item--compact {
      max-width: 20.625rem;
    }
  }
</style>
